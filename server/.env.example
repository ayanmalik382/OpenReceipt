# --- Required ---
# Get this from your Neon project: Dashboard -> Connect -> pick "asyncpg". It looks like:
#   postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname
# This app rewrites it to the asyncpg driver form automatically, so either "postgresql://"
# or "postgresql+asyncpg://" both work here.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/receiptbook
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-please

# --- Server ---
PORT=8000
ENVIRONMENT=development
# Set to 1 when running behind a reverse proxy / load balancer (needed for correct rate limiting by IP)
TRUST_PROXY=0

# --- Email (required when ENVIRONMENT=production; otherwise OTP codes print to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReceiptBook <no-reply@example.com>
